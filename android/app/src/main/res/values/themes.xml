<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light: the window background matches the Compose light scheme so
         there is no gray flash/bleed behind screens that don't paint their
         own background. -->
    <style name="Theme.RustDroid" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/rd_window_background</item>
    </style>
</resources>
