{
  "name": "RustDroid Light",
  "type": "light",
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#3B3B3B",
    "editor.selectionBackground": "#ADD6FF",
    "editor.lineHighlightBackground": "#F5F5F5",
    "editorLineNumber.foreground": "#858585",
    "editorLineNumber.activeForeground": "#171184",
    "editorCursor.foreground": "#000000",
    "editorWhitespace.foreground": "#E0E0E0"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#008000" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#A31515" } },
    { "scope": ["constant.character.escape", "constant.character", "constant.language", "constant.other", "entity.name.constant", "variable.other.constant"], "settings": { "foreground": "#0000FF" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#098658" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.other"], "settings": { "foreground": "#0000FF" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#3B3B3B" } },
    { "scope": ["entity.name.function", "support.function", "meta.function.call", "meta.function.definition"], "settings": { "foreground": "#795E26" } },
    { "scope": ["entity.name.type", "entity.name.type.instance", "support.type", "support.class", "entity.name.struct"], "settings": { "foreground": "#267F99" } },
    { "scope": ["entity.name.enum", "entity.name.enum.variant", "variable.other.enummember"], "settings": { "foreground": "#007ACC" } },
    { "scope": ["entity.name.macro", "meta.macro", "support.macro"], "settings": { "foreground": "#795E26" } },
    { "scope": ["variable.parameter", "variable.other", "variable", "meta.parameter"], "settings": { "foreground": "#001080" } },
    { "scope": ["entity.name.attribute", "meta.attribute", "meta.annotation"], "settings": { "foreground": "#795E26" } },
    { "scope": "lifetime", "settings": { "foreground": "#795E26" } },
    { "scope": ["punctuation", "meta.brace", "meta.bracket", "meta.paragraph"], "settings": { "foreground": "#3B3B3B" } },
    { "scope": "invalid", "settings": { "foreground": "#CD3131" } },
    { "scope": "source", "settings": { "foreground": "#3B3B3B" } }
  ]
}
