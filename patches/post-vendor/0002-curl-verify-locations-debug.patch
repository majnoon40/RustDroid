+/* RUSTDROID-FIX: fallback CA loader for OpenSSL builds where the file BIO is
+ * compiled out (OPENSSL_NO_STDIO). openssl-src-rs passes `no-stdio` for every
+ * Android target (workaround for openssl-src-rs#13, a 2016 OpenSSL-1.0.x era
+ * issue), which compiles bss_file.c's BIO_new_file() as a stub that always
+ * returns NULL WITHOUT queueing an error. X509_STORE_load_locations() then
+ * fails with exactly one queued error:
+ *   x509 certificate routines:X509_load_cert_crl_file:system lib
+ * and every HTTPS request dies with CURLE_SSL_CACERT_BADFILE (curl 77)
+ * regardless of the CA bundle being perfectly readable through plain stdio.
+ * This fallback reads the bundle with C stdio (unaffected by OPENSSL_NO_STDIO)
+ * and parses it via a read-only memory BIO into the X509_STORE. */
+static CURLcode rustdroid_load_ca_fallback(struct Curl_easy *data,
+                                           X509_STORE *store,
+                                           const char *cafile)
+{
+  CURLcode result = CURLE_SSL_CACERT_BADFILE;
+  FILE *caf = NULL;
+  unsigned char *cbuf = NULL;
+  long casize;
+  size_t canread;
+  BIO *mem = NULL;
+  STACK_OF(X509_INFO) *sk = NULL;
+  int i, added = 0;
+
+  caf = fopen(cafile, "rb");
+  if(!caf) {
+    failf(data, "RUSTDROID-DEBUG: fallback fopen(%s) FAILED errno=%d (%s)",
+          cafile, errno, strerror(errno));
+    goto done;
+  }
+  fseek(caf, 0, SEEK_END);
+  casize = ftell(caf);
+  fseek(caf, 0, SEEK_SET);
+  if(casize <= 0) {
+    failf(data, "RUSTDROID-DEBUG: fallback stat %s size=%ld", cafile, casize);
+    goto done;
+  }
+  cbuf = malloc((size_t)casize);
+  if(!cbuf) {
+    result = CURLE_OUT_OF_MEMORY;
+    goto done;
+  }
+  canread = fread(cbuf, 1, (size_t)casize, caf);
+  if(canread != (size_t)casize) {
+    failf(data, "RUSTDROID-DEBUG: fallback fread short: %zu of %ld bytes",
+          canread, casize);
+    goto done;
+  }
+  mem = BIO_new_mem_buf(cbuf, (int)casize);
+  if(!mem) {
+    failf(data, "RUSTDROID-DEBUG: fallback BIO_new_mem_buf FAILED");
+    goto done;
+  }
+  sk = PEM_X509_INFO_read_bio(mem, NULL, NULL, "");
+  if(!sk) {
+    failf(data, "RUSTDROID-DEBUG: fallback PEM parse FAILED (not PEM?)");
+    goto done;
+  }
+  for(i = 0; i < sk_X509_INFO_num(sk); i++) {
+    X509_INFO *itmp = sk_X509_INFO_value(sk, i);
+    if(itmp->x509 && X509_STORE_add_cert(store, itmp->x509))
+      added++;
+    if(itmp->crl && X509_STORE_add_crl(store, itmp->crl))
+      added++;
+  }
+  infof(data, "RUSTDROID-DEBUG: fallback CA load: %d entries from %s",
+        added, cafile);
+  if(added > 0)
+    result = CURLE_OK;
+done:
+  sk_X509_INFO_pop_free(sk, X509_INFO_free);
+  BIO_free(mem);            /* read-only mem BIO does not own cbuf */
+  free(cbuf);
+  if(caf)
+    fclose(caf);
+  return result;
+}
